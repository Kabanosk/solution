# Copy to .env (git-ignored) and adjust. See docs/scout-auth.md before using existing data.
# Database auth migration and explicit worker organization/ownership are required; no auth bypass defaults.

# Postgres of docker-compose.yml (host port 5433)
DATABASE_URL=postgresql://cfo:cfo@localhost:5433/cfo
# Required for worker/MCP/mock-bank operator processes, not a substitute for web sessions:
SCOUT_ORGANIZATION_ID=
# Only explicitly authorize the existing reserved Amalfi org's legacy integration settings:
SCOUT_LEGACY_CONNECTORS_ORGANIZATION=

# OpenAI-compatible endpoint: vLLM, or the NeMo Guardrails proxy at the same URL (D-009)
LLM_BASE_URL=http://localhost:8000/v1
LLM_MODEL=llama-3.2-3b
LLM_API_KEY=EMPTY
# true | false | path to a CA bundle (OpenShift service CA for the in-cluster vLLM endpoint)
LLM_VERIFY_TLS=true

# Slack bot (Socket Mode): bot token xoxb-..., app-level token xapp-...
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
# Optional: employee id -> Slack user id (overrides the slack_user_id from HR data)
SLACK_USER_MAP=

# Root of the simulated company computers: <root>/<employee>/{Downloads,Mail,...}
WORKSTATIONS_ROOT=data/generated/workstations

# Simulator speed multiplier: 1.0 = real time, 3600 = one simulated hour per second
SIM_SPEED=1.0

# API: allowed browser origins, comma-separated or * (default)
CORS_ORIGINS=*

# Worker (python -m cfo.run). MCP servers over HTTP; leave empty to call the tools in-process
MCP_COMPANY_DB_URL=
MCP_WORKSTATIONS_URL=
MCP_HR_URL=
# Generated data with events/december.jsonl
DATA_DIR=data/generated
# Scheduled checks and reminders, in simulated hours
COST_CHECK_HOURS=24
LIQUIDITY_CHECK_HOURS=744
REMINDER_AFTER_HOURS=24
# 1 = the API process builds its own agent (dashboard approvals, POST /v1/sim:step)
AGENT_IN_API=0

# Forecast model from the MLflow registry (needs the `mlflow` extra and MLFLOW_TRACKING_URI in the process
# environment). Empty = local model file (FORECAST_MODEL_PATH, trained on first use).
# Example: models:/liquidity-forecast@champion
FORECAST_MODEL_URI=

# MLflow (optional, needs `uv sync --extra mlflow`). MLFLOW_* variables are read from the process environment
# only (export them; they are not picked up from .env). MLFLOW_TRACKING_URI unset = MLflow off. When set, every
# agent event becomes one trace in MLFLOW_AGENT_EXPERIMENT (default cfo-agent). Auth: MLflow's standard variables
# (on RHOAI: MLFLOW_TRACKING_AUTH=kubernetes-namespaced).
# MLFLOW_TRACKING_URI=http://localhost:5000
# MLFLOW_AGENT_EXPERIMENT=cfo-agent

# LLM usage and cost estimate (T032). Unset VLLM_METRICS_URL = the vLLM metrics sampler is off.
# python -m cfo.usage sample --every 60
VLLM_METRICS_URL=
# true | false (self-signed certificate) | CA bundle path
VLLM_METRICS_VERIFY=true
# Hourly price of one NVIDIA L4 (assumption: AWS g6.xlarge, see docs/api.md) and an optional node share, EUR
GPU_HOURLY_COST_EUR=0.70
NODE_HOURLY_COST_EUR=0

# Workspace onboarding (T053): provider connections an organization owner authorizes from Scout's setup checklist.
# Unset values are reported honestly as "needs configuration" in the setup API; nothing is faked or inherited.
# Public origin of the dashboard. OAuth redirects must be exactly <origin>/api/onboarding/callback/<provider>.
# https only (http is accepted for localhost/127.0.0.1 development).
SCOUT_APP_ORIGIN=
# Server secret (32+ characters, e.g. a Fernet key) from which per-organization, per-connection sealing keys are
# derived for connection credentials. Losing or changing it makes stored credentials unreadable (reconnect).
CONNECTIONS_KEY=
# Dedicated Google OAuth client for MAILBOX access (gmail.readonly, offline). NOT the dashboard sign-in client
# (SCOUT_GOOGLE_*). Redirect URI to register: <SCOUT_APP_ORIGIN>/api/onboarding/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Slack app (OAuth v2, read-only bot scopes). Redirect URI to register: <SCOUT_APP_ORIGIN>/api/onboarding/callback/slack
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
# bunq uses a fixed sandbox host; KSeF uses a fixed test host. Owner-supplied test identity/API key and
# environment authentication/network prerequisites are verified during setup, never assumed connected.

# Daily CEO strategy briefing: 07:00 Europe/Berlin, stored in Agent Tasks (no Slack message).
# Optional legacy-organization target; other tenants never inherit it. No target means progress unknown.
STRATEGY_CURRENCY=EUR
# STRATEGY_MONTHLY_REVENUE_TARGET=50000
# These optional goals are recorded in the scorecard; assessment stays unknown until inputs are reconciled/tagged.
# STRATEGY_OPERATING_SURPLUS_TARGET=10000
# STRATEGY_OWNER_INCOME_TARGET=4000
