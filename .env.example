# Copy to .env (git-ignored) and adjust. Every variable is optional; defaults shown.

# Postgres of docker-compose.yml (host port 5433)
DATABASE_URL=postgresql://cfo:cfo@localhost:5433/cfo

# OpenAI-compatible endpoint: vLLM, or the NeMo Guardrails proxy at the same URL (D-009)
LLM_BASE_URL=http://localhost:8000/v1
LLM_MODEL=llama-3.2-3b
LLM_API_KEY=EMPTY
# true | false | path to a CA bundle (OpenShift service CA for the in-cluster vLLM endpoint)
LLM_VERIFY_TLS=true

# Slack bot (Socket Mode): bot token xoxb-..., app-level token xapp-...
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
# Optional: employee id -> Slack user id (overrides the slack_user_id from HR data)
SLACK_USER_MAP=

# Root of the simulated company computers: <root>/<employee>/{Downloads,Mail,...}
WORKSTATIONS_ROOT=data/generated/workstations

# Simulator speed multiplier: 1.0 = real time, 3600 = one simulated hour per second
SIM_SPEED=1.0

# API: allowed browser origins, comma-separated or * (default)
CORS_ORIGINS=*

# Worker (python -m cfo.run). MCP servers over HTTP; leave empty to call the tools in-process
MCP_COMPANY_DB_URL=
MCP_WORKSTATIONS_URL=
MCP_HR_URL=
# Generated data with events/december.jsonl
DATA_DIR=data/generated
# Scheduled checks and reminders, in simulated hours
COST_CHECK_HOURS=24
LIQUIDITY_CHECK_HOURS=744
REMINDER_AFTER_HOURS=24
# 1 = the API process builds its own agent (dashboard approvals, POST /v1/sim:step)
AGENT_IN_API=0

# Forecast model from the MLflow registry (needs the `mlflow` extra and MLFLOW_TRACKING_URI in the process
# environment). Empty = local model file (FORECAST_MODEL_PATH, trained on first use).
# Example: models:/liquidity-forecast@champion
FORECAST_MODEL_URI=

# LLM usage and cost estimate (T032). Unset VLLM_METRICS_URL = the vLLM metrics sampler is off.
# python -m cfo.usage sample --every 60
VLLM_METRICS_URL=
# true | false (self-signed certificate) | CA bundle path
VLLM_METRICS_VERIFY=true
# Hourly price of one NVIDIA L4 (assumption: AWS g6.xlarge, see docs/api.md) and an optional node share, EUR
GPU_HOURLY_COST_EUR=0.70
NODE_HOURLY_COST_EUR=0
