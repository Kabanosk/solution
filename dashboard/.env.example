# Runtime only. Never prefix these with NEXT_PUBLIC_.
# Set to 1 for a local UI preview with sample data and no login/database.
# Ignored outside `next dev`. Set to 0 to use the real services below.
DASHBOARD_PREVIEW=0
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=cfo
PGUSER=cfo
PGPASSWORD=
CFO_API_URL=http://127.0.0.1:8000
# Optional server-only bearer token for the CFO API's read endpoints (LLM usage telemetry).
CFO_API_TOKEN=
# Server-only write token for the Scout API: Scout chat, Approve/Reject, Connect Google, demo panel.
API_WRITE_TOKEN=
# Set to 1 to show the dev demo panel (posts scenario payments to the bank mock).
SCOUT_DEMO=0
# Employee id that the dashboard login acts as (Inbox / My tasks / approvals).
SCOUT_CEO_ID=vincenzo
DASHBOARD_USERNAME=
DASHBOARD_PASSWORD=
