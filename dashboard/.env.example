# Runtime only. Never prefix these with NEXT_PUBLIC_.
# Set to 1 for a local UI preview with sample data and no login/database.
# Ignored outside `next dev`. Set to 0 to use the real services below.
DASHBOARD_PREVIEW=0
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=cfo
PGUSER=cfo
PGPASSWORD=
CFO_API_URL=http://127.0.0.1:8000
# Optional server-only bearer token for the CFO API or its gateway.
CFO_API_TOKEN=
# Server-only OpenAI-compatible chat endpoint; defaults to the Granite service.
# Outside OpenShift, port-forward the model pod and use http://127.0.0.1:18080/v1.
LLM_CHAT_BASE_URL=http://modelcar-granite-4-0-h-tiny-predictor.my-first-model.svc.cluster.local:8080/v1
# Optional; the current internal Granite endpoint does not require a key.
LLM_CHAT_API_KEY=
DASHBOARD_USERNAME=
DASHBOARD_PASSWORD=
