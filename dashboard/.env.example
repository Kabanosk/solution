# Runtime only. Never prefix credentials with NEXT_PUBLIC_.
# Required, exact browser origin. Local dev uses 127.0.0.1, not localhost.
SCOUT_APP_ORIGIN=http://127.0.0.1:3000
# Required in production: ingress must OVERWRITE this header with a single validated client IP.
# OpenShift Route: haproxy.router.openshift.io/set-forwarded-headers: replace
SCOUT_TRUSTED_CLIENT_IP_HEADER=
# Same migrated database used by the Python API. PG* below are an alternative.
DATABASE_URL=
# Optional separate connection identity for scout_auth tables and organization provisioning.
SCOUT_AUTH_DATABASE_URL=
# Scout sign-in ONLY; these are NOT the mailbox connection's GOOGLE_* variables.
# Register callback: <SCOUT_APP_ORIGIN>/api/auth/google/callback
SCOUT_GOOGLE_CLIENT_ID=
SCOUT_GOOGLE_CLIENT_SECRET=
# Optional HTTPS overrides. Empty uses Scout's public /privacy and /terms pages.
# Update the policy before introducing Gmail or other new data access.
SCOUT_PRIVACY_URL=
SCOUT_TERMS_URL=
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=cfo
PGUSER=cfo
PGPASSWORD=
CFO_API_URL=http://127.0.0.1:8000
# No Basic-auth or shared write-token fallback. Requests carry the member's opaque session.
# New organizations receive no sample data, connectors or environment-level integration secrets.

# Persisted provider keys; generate a stable random secret of at least 32 characters.
SCOUT_STRATEGY_SECRET=
# Enables the dashboard pod's daily scheduler (due-time check every minute).
SCOUT_STRATEGY_SCHEDULER=1
