{
  "cfo": {
    "ignore_empty": false,
    "fields": {
      "database_url": {
        "type": "string",
        "nullable": false,
        "default": "postgresql://cfo:cfo@localhost:5433/cfo"
      },
      "llm_base_url": {
        "type": "string",
        "nullable": false,
        "default": "http://localhost:8000/v1"
      },
      "llm_model": {
        "type": "string",
        "nullable": false,
        "default": "llama-3.2-3b"
      },
      "llm_api_key": {
        "type": "string",
        "nullable": false,
        "default": "EMPTY"
      },
      "llm_verify_tls": {
        "type": "string",
        "nullable": false,
        "default": "true"
      },
      "slack_bot_token": {
        "type": "string",
        "nullable": false,
        "default": ""
      },
      "slack_app_token": {
        "type": "string",
        "nullable": false,
        "default": ""
      },
      "slack_user_map": {
        "type": "string",
        "nullable": false,
        "default": ""
      },
      "workstations_root": {
        "type": "path",
        "nullable": false,
        "default": "data/generated/workstations"
      },
      "sim_speed": {
        "type": "number",
        "nullable": false,
        "default": 1.0
      },
      "forecast_model_uri": {
        "type": "string",
        "nullable": false,
        "default": ""
      }
    }
  },
  "api": {
    "ignore_empty": true,
    "fields": {
      "cors_origins": {
        "type": "string",
        "nullable": false,
        "default": "*"
      },
      "api_write_token": {
        "type": "string",
        "nullable": true,
        "default": null
      },
      "ceo_id": {
        "type": "string",
        "nullable": false,
        "default": "vincenzo"
      },
      "safety_buffer_eur": {
        "type": "decimal",
        "nullable": true,
        "default": null
      }
    }
  },
  "scout": {
    "ignore_empty": true,
    "fields": {
      "database_url": {
        "type": "string",
        "nullable": false,
        "default": "postgresql://cfo:cfo@localhost:5434/cfo"
      },
      "scout_workers": {
        "type": "integer",
        "nullable": false,
        "default": 4
      },
      "strategy_operating_surplus_target": {
        "type": "decimal",
        "nullable": true,
        "default": null,
        "allow_inf_nan": false
      },
      "strategy_owner_income_target": {
        "type": "decimal",
        "nullable": true,
        "default": null,
        "ge": 0,
        "allow_inf_nan": false
      },
      "strategy_currency": {
        "type": "string",
        "nullable": false,
        "default": "EUR",
        "pattern": "^[A-Z]{3}$"
      },
      "strategy_monthly_revenue_target": {
        "type": "decimal",
        "nullable": true,
        "default": null,
        "gt": 0,
        "allow_inf_nan": false
      },
      "reminder_after_hours": {
        "type": "number",
        "nullable": false,
        "default": 24.0
      },
      "chat_lookback_days": {
        "type": "integer",
        "nullable": false,
        "default": 30
      },
      "chat_channels": {
        "type": "list",
        "nullable": false,
        "default": [
          "finance"
        ]
      },
      "bank_api_url": {
        "type": "string",
        "nullable": false,
        "default": "http://localhost:8010"
      },
      "bank_poll_seconds": {
        "type": "number",
        "nullable": false,
        "default": 5.0
      },
      "mail_poll_seconds": {
        "type": "number",
        "nullable": false,
        "default": 30.0
      },
      "google_client_id": {
        "type": "string",
        "nullable": false,
        "default": ""
      },
      "google_client_secret": {
        "type": "string",
        "nullable": false,
        "default": ""
      },
      "google_redirect_uri": {
        "type": "string",
        "nullable": false,
        "default": "http://localhost:8000/v1/connections/google/callback"
      },
      "google_mail_label": {
        "type": "string",
        "nullable": false,
        "default": "Amalfi"
      },
      "connections_key": {
        "type": "string",
        "nullable": false,
        "default": ""
      },
      "oauth_state_secret": {
        "type": "string",
        "nullable": false,
        "default": ""
      },
      "scout_app_origin": {
        "type": "string",
        "nullable": false,
        "default": ""
      },
      "slack_client_id": {
        "type": "string",
        "nullable": false,
        "default": ""
      },
      "slack_client_secret": {
        "type": "string",
        "nullable": false,
        "default": ""
      },
      "dashboard_url": {
        "type": "string",
        "nullable": false,
        "default": "http://127.0.0.1:3000"
      },
      "scout_icon_url": {
        "type": "string",
        "nullable": false,
        "default": ""
      },
      "ceo_id": {
        "type": "string",
        "nullable": false,
        "default": "vincenzo"
      },
      "document_owner_id": {
        "type": "string",
        "nullable": false,
        "default": "grazyna"
      },
      "workstations_root": {
        "type": "string",
        "nullable": false,
        "default": "data/generated/workstations"
      },
      "data_dir": {
        "type": "string",
        "nullable": false,
        "default": "data/generated"
      },
      "slack_bot_token": {
        "type": "string",
        "nullable": false,
        "default": ""
      },
      "slack_app_token": {
        "type": "string",
        "nullable": false,
        "default": ""
      },
      "slack_user_map": {
        "type": "string",
        "nullable": false,
        "default": ""
      },
      "slack_sweep_seconds": {
        "type": "integer",
        "nullable": false,
        "default": 600
      },
      "api_write_token": {
        "type": "string",
        "nullable": false,
        "default": ""
      },
      "scout_demo": {
        "type": "boolean",
        "nullable": false,
        "default": false
      },
      "guardrails_url": {
        "type": "string",
        "nullable": false,
        "default": ""
      },
      "guardrails_token": {
        "type": "string",
        "nullable": false,
        "default": ""
      },
      "guardrails_ca": {
        "type": "string",
        "nullable": false,
        "default": "/var/run/secrets/kubernetes.io/serviceaccount/service-ca.crt"
      },
      "compliance_contact": {
        "type": "string",
        "nullable": false,
        "default": ""
      },
      "ksef_api_url": {
        "type": "string",
        "nullable": false,
        "default": "https://api-test.ksef.mf.gov.pl/v2"
      }
    }
  }
}
